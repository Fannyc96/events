# 複製這份成 .env.local，填入 Supabase 後台 Project Settings → API 的值。
# .env.local 已被 .gitignore 排除，不會被 commit。
# 部署時，同樣兩個值要放到 GitHub repo 的 Settings → Secrets and variables → Actions。

# Project URL，例：https://abcdefghijklmn.supabase.co
VITE_SUPABASE_URL=

# anon public key（不是 service_role！service_role 絕對不能放前端）
VITE_SUPABASE_ANON_KEY=
